<Project Sdk="Microsoft.NET.Sdk.Web">

	<PropertyGroup>
		<TargetFramework>net10.0</TargetFramework>
		<Nullable>enable</Nullable>
	</PropertyGroup>

	<ItemGroup>
		<PackageReference Include="Azure.Monitor.OpenTelemetry.AspNetCore" Version="1.6.0" />
		<PackageReference Include="FluentValidation" Version="12.2.0" />
		<PackageReference Include="FluentValidation.DependencyInjectionExtensions" Version="12.2.0" />
		<PackageReference Include="Azure.Identity" Version="1.21.0" />
		<PackageReference Include="MediatR" Version="12.5.0" />
		<PackageReference Include="Microsoft.OpenApi" Version="2.7.5" />
		<PackageReference Include="SFA.DAS.Encoding" Version="1.1.94" />
		<PackageReference Include="Microsoft.EntityFrameworkCore" Version="10.0.9" />
		<PackageReference Include="SFA.DAS.Api.Common" Version="17.1.196" />
		<PackageReference Include="SFA.DAS.Configuration.AzureTableStorage" Version="17.1.165" />
		<PackageReference Include="SFA.DAS.Notifications.Messages" Version="3.0.10" />
    <PackageReference Include="Swashbuckle.AspNetCore.SwaggerUI" Version="11.0.1" />
    <PackageReference Include="Swashbuckle.AspNetCore.SwaggerGen" Version="10.1.7" />
		<PackageReference Include="System.IdentityModel.Tokens.Jwt" Version="8.23.0" />
	</ItemGroup>

	<ItemGroup>
		<ProjectReference Include="..\SFA.DAS.Assessor.Application\SFA.DAS.Assessor.Application.csproj" />
		<ProjectReference Include="..\SFA.DAS.Assessor.Data\SFA.DAS.Assessor.Data.csproj" />
	</ItemGroup>

  <Target Name="GenerateSwaggerJson" AfterTargets="Build" Condition="'$(TF_BUILD)' != 'True'">
    <Exec Command="dotnet tool run swagger tofile --output &quot;$(MSBuildThisFileDirectory)swagger.json&quot; &quot;$(TargetPath)&quot; v1" WorkingDirectory="$(MSBuildProjectDirectory)" />
  </Target>
</Project>
