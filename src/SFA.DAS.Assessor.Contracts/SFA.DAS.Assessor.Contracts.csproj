<Project Sdk="Microsoft.NET.Sdk">

    <PropertyGroup>
        <TargetFramework>net10.0</TargetFramework>
        <ImplicitUsings>enable</ImplicitUsings>
        <RootNamespace>SFA.DAS.Assessor.Contracts</RootNamespace>
        <AssemblyName>SFA.DAS.Assessor.Contracts</AssemblyName>
        <Nullable>enable</Nullable>
        <ApiContractsSwaggerJsonPath>$(MSBuildThisFileDirectory)..\SFA.DAS.Assessor.Api\swagger.json</ApiContractsSwaggerJsonPath>
        <ApiContractsNamespace>SFA.DAS.Assessor.Contracts</ApiContractsNamespace>
        <ApiContractsOutputDirectory>$(MSBuildThisFileDirectory)Generated</ApiContractsOutputDirectory>
        <ApiContractsClientName>AssessorApi</ApiContractsClientName>
        <IsPackable>true</IsPackable>
        <Authors>GOV.UK Department for Education (DfE) Digital Apprenticeship Service (DAS)</Authors>
        <Description>Assessor API request and response for use with APIM.</Description>
        <License>https://github.com/SkillsFundingAgency/das-shared-packages/blob/master/LICENSE</License>
        <PackageProjectUrl>https://github.com/SkillsFundingAgency/das-digital-Assessor-api</PackageProjectUrl>
        <IncludeSymbols>true</IncludeSymbols>
        <SymbolPackageFormat>snupkg</SymbolPackageFormat>
        <DefaultItemExcludes>
            $(DefaultItemExcludes);
            $(ApiContractsOutputDirectory)\**\*.cs
        </DefaultItemExcludes>
    </PropertyGroup>

    <ItemGroup>
        <PackageReference Include="OpenTelemetry.Api" Version="1.21.0" />
        <PackageReference Include="SFA.DAS.ApiContracts.Build" Version="17.1.196" />
        <PackageReference Include="SFA.DAS.Apim.Shared" Version="17.1.209" />
        <PackageReference Include="System.Security.Cryptography.Xml" Version="11.0.0" />
    </ItemGroup>

    <ItemGroup>
      <Folder Include="Generated\" />
    </ItemGroup>

</Project>